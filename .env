# Comma-separated list of Gemini API keys.
# The server rotates through them automatically to avoid quota exhaustion.
# Add as many keys as you have:  key1,key2,key3,...
GEMINI_API_KEYS=AIzaSyCws91pPECgzQJtQ7SmSG8Jb0mX4TSJRfI, AIzaSyCs5IS7D_TjtQwnLL3723vhSXOMKrVfif4, AIzaSyDhYyWBcEgSYYoSk4ByFvkpZa16ouPlH5c, AIzaSyA38uIhZSBzb12zzfLHjHHzBjDu-eDdCRw, AIzaSyCIdo629b_tSXLzDw2wRX1bDMdj0M7DbQ0, AIzaSyBaBgVO9MK-lKBtwKDd0SH5D_XG7WJ4vt0

# Fallback: if GEMINI_API_KEYS is not set, the server also checks GEMINI_API_KEY (singular).
# GEMINI_API_KEY=AIzaSyCs5IS7D_TjtQwnLL3723vhSXOMKrVfif4

GEMINI_MODEL=gemini-2.5-flash

# Cooldown in seconds when a key hits 429 (default: 60).
KEY_COOLDOWN_SECONDS=60

# Optional: change the local server port.
PORT=3000
